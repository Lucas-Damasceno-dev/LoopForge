# LoopForge v6 - Environment Variables Configuration Example
# Default LLM provider: OpenCode Zen (https://opencode.ai/docs/zen)
# OpenAI-compatible endpoint; as variáveis OPENROUTER_* são reutilizadas
# pelo pipeline para o endpoint Zen.

# API Key do OpenCode Zen (https://opencode.ai/auth) - sk-...
OPENROUTER_API_KEY=

# Base URL OpenAI-compatível do OpenCode Zen
OPENROUTER_BASE_URL=https://opencode.ai/zen/v1

# Preferred LLM Model (Default: deepseek-v4-flash-free)
OPENROUTER_MODEL=deepseek-v4-flash-free

# Timeout (seconds) before LLM HTTP call times out; raise to 300 for reasoning models
# OPENROUTER_TIMEOUT=300

# Model for the OpenCode subprocess (fallback)
OPENCODE_MODEL=deepseek-v4-flash-free

# Mock mode (no real LLM calls)
# OPENCODE_MOCK=1

# LoopForge API Server Configuration
LF_API_HOST=0.0.0.0
LF_API_PORT=8000
LF_API_KEY=
