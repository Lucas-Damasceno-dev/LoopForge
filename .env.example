# LoopForge v6 - Environment Variables Configuration Example

# OpenRouter API Key (sk-or-v1-...)
OPENROUTER_API_KEY=

# Preferred LLM Model (Default: auto/best-free)
OPENROUTER_MODEL=auto/best-free

# Timeout (seconds) before LLM HTTP call times out; raise to 300 for reasoning models
# OPENROUTER_TIMEOUT=300

# Custom base URL (OmniRoute local proxy)
# OPENROUTER_BASE_URL=http://localhost:20128/v1

# Model for the OpenCode subprocess
OPENCODE_MODEL=auto/best-free

# Mock mode (no real LLM calls)
# OPENCODE_MOCK=1

# LoopForge API Server Configuration
LF_API_HOST=0.0.0.0
LF_API_PORT=8000
LF_API_KEY=
