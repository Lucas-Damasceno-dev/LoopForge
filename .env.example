# LoopForge v6 - Environment Variables Configuration Example
# Default LLM provider: OpenCode Zen (https://opencode.ai/docs/zen)
# OpenAI-compatible endpoint; as variáveis OPENROUTER_* são reutilizadas
# pelo pipeline para o endpoint Zen.

# API Key do OpenCode Zen (https://opencode.ai/auth) - sk-...
OPENROUTER_API_KEY=

# API Key para o subprocesso do CLI opencode (mesma conta Zen) - sk-...
OPENCODE_API_KEY=

# Base URL OpenAI-compatível do OpenCode Zen
OPENROUTER_BASE_URL=https://opencode.ai/zen/v1

# Preferred LLM Model (Default: deepseek-v4-flash-free) - usado no caminho HTTP (API Zen)
OPENROUTER_MODEL=deepseek-v4-flash-free

# Timeout (seconds) before LLM HTTP call times out; vazio/0 = sem timeout (padrão)
# OPENROUTER_TIMEOUT=

# Modelo para o subprocesso do CLI opencode (fallback).
# O CLI exige o formato provider/model -> prefixo "opencode/".
OPENCODE_MODEL=opencode/deepseek-v4-flash-free

# Timeout do subprocesso opencode (segundos); vazio/0 = sem timeout (padrão)
# OPENCODE_TIMEOUT=

# Timeout da auditoria paralela AppSec+DevOps (segundos); vazio/0 = sem timeout (padrão)
# LF_AUDIT_TIMEOUT=

# Timeout da execução de testes do QA (segundos); vazio/0 = sem timeout (padrão)
# LF_TEST_TIMEOUT=

# Mock mode (no real LLM calls)
# OPENCODE_MOCK=1

# LoopForge API Server Configuration
LF_API_HOST=0.0.0.0
LF_API_PORT=8000
LF_API_KEY=

# ─── Multi-worker (fila global) ──────────────────────────────────────────
# LF_QUEUE_BACKEND=memory   # memory (single-process, BC) | redis (multi-worker)
# LF_REDIS_URL=redis://localhost:6379
