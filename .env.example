# LoopForge v6 - Environment Variables Configuration Example

# OpenRouter API Key (sk-or-v1-...)
OPENROUTER_API_KEY=

# Preferred LLM Model (Default: free fast model inclusionai/ling-3.0-flash:free)
OPENROUTER_MODEL=inclusionai/ling-3.0-flash:free

# LoopForge API Server Configuration
LF_API_HOST=0.0.0.0
LF_API_PORT=8000
LF_API_KEY=
