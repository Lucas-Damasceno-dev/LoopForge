# Porta HTTP do serviço
PORT=8080

# Timeouts do servidor HTTP (em segundos)
READ_TIMEOUT_SECONDS=10
WRITE_TIMEOUT_SECONDS=10
SHUTDOWN_TIMEOUT_SECONDS=15

# Chave de API obrigatória para ingestão de logs.
# Deve ser enviada no header: X-API-Key
API_KEY=change-me

# Nível mínimo de severidade para persistência.
# Valores aceitos: INFO, WARN, ERROR
MIN_SEVERITY=INFO

# Conexão PostgreSQL. Se vazio, o serviço usa repositório em memória (dev).
DATABASE_URL=postgres://log_ingestor:log_ingestor@localhost:5432/log_ingestor?sslmode=disable

# Palavras-chave para classificação automática de severidade (separadas por vírgula)
ERROR_KEYWORDS=error,failed,panic,exception
WARN_KEYWORDS=warn,timeout,slow,degraded